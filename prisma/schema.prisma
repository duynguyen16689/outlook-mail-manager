generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String   @id @default(cuid())
  code               String   @unique
  nickname           String?
  status             String   @default("ACTIVE")
  proxyInfo          String?
  credentialsSummary String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
